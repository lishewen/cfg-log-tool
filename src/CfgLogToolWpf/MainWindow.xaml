<Window x:Class="CfgLogToolWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CfgLogTool — 仪器工作站日志编辑器 (WPF)" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" PreviewDragOver="Window_DragOver">
    <DockPanel>
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="#F4F5F9" Padding="12,8" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button x:Name="BtnOpen" Content="打开 .cfg" Click="BtnOpen_Click" MinWidth="88" Height="30" Padding="10,0"/>
                        <Button x:Name="BtnSave" Content="保存修改" Click="BtnSave_Click" MinWidth="88" Height="30" Margin="8,0,0,0" Padding="10,0"/>
                        <Button x:Name="BtnSaveAs" Content="另存为…" Click="BtnSaveAs_Click" MinWidth="88" Height="30" Margin="8,0,0,0" Padding="10,0"/>
                        <Button x:Name="BtnExport" Content="导出三件套" Click="BtnExport_Click" MinWidth="96" Height="30" Margin="8,0,0,0" Padding="10,0"/>
                        <Button x:Name="BtnReload" Content="还原全部改动" Click="BtnReload_Click" MinWidth="110" Height="30" Margin="8,0,0,0" Padding="10,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TbFile" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="#555" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                               Text="未打开文件 — 可将 .cfg 拖入窗口"/>
                </DockPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="筛选：" VerticalAlignment="Center"/>
                    <TextBox x:Name="TbFilter" Height="27" VerticalContentAlignment="Center" TextChanged="TbFilter_TextChanged"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 底部状态栏 -->
        <Border DockPanel.Dock="Bottom" Background="#F4F5F9" Padding="12,5" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TbStatus" Text="就绪 — 打开或拖入 .cfg 日志文件开始"/>
        </Border>

        <!-- 右侧操作面板 -->
        <Border DockPanel.Dock="Right" Width="330" Padding="12" BorderBrush="#DDD" BorderThickness="1,0,0,0">
            <StackPanel>
                <TextBlock Text="修改选中记录时间" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <TextBlock Text="ItemObj："/>
                <TextBlock Text="{Binding ElementName=Grid, Path=SelectedItem.ItemObj, TargetNullValue=（未选中）}"
                           TextWrapping="Wrap" Foreground="#666" FontFamily="Consolas" Margin="0,2,0,10"/>
                <TextBlock Text="当前时间："/>
                <TextBlock x:Name="TbCurDate" Text="—" FontWeight="Bold" Margin="0,2,0,10"/>
                <TextBlock Text="新日期："/>
                <DatePicker x:Name="DpNewDate" Margin="0,2,0,10"/>
                <TextBlock Text="新时间 (HH:mm:ss)："/>
                <TextBox x:Name="TbNewTime" Height="27" Text="00:00:00" VerticalContentAlignment="Center" Margin="0,2,0,12"
                         FontFamily="Consolas"/>
                <Button Content="应用新时间" Click="BtnApplyDate_Click" Height="34" Background="#E8F0FE"/>
                <Button Content="删除选中条目（可多选）" Click="BtnDeleteSelected_Click" Height="34" Margin="0,10,0,0" Background="#FDECEC"/>
                <Button Content="恢复选中条目" Click="BtnRestoreSelected_Click" Height="34" Margin="0,10,0,0" Background="#EAF7EA"/>
                <Border Background="#FFFBEA" CornerRadius="4" Padding="8" Margin="0,16,0,0">
                    <TextBlock TextWrapping="Wrap" Foreground="#7A5C00" LineHeight="20"
                               Text="提示：删除与改时间均基于原文件计算，保存时输出新文件（默认 *_edit.cfg），原文件不会被覆盖；保存前自动做回读验证。"/>
                </Border>
                <TextBlock x:Name="TbFileInfo" Margin="0,16,0,0" TextWrapping="Wrap" Foreground="#444" LineHeight="22"/>
            </StackPanel>
        </Border>

        <!-- 中部条目表格 -->
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  SelectionMode="Extended" SelectionUnit="FullRow"
                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                  AlternatingRowBackground="#FAFAFA" FontSize="12.5"
                  SelectionChanged="Grid_SelectedItemChanged">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                            <Setter Property="Foreground" Value="#B0B0B0"/>
                            <Setter Property="Background" Value="#F6F6F6"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEdited}" Value="True">
                            <Setter Property="Background" Value="#FFF6D6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="时间 ItemDate" Binding="{Binding ItemDate}" Width="170"/>
                <DataGridTextColumn Header="用户" Binding="{Binding ItemName}" Width="95"/>
                <DataGridTextColumn Header="类型 ItemType" Binding="{Binding ItemType}" Width="160"/>
                <DataGridTextColumn Header="操作 ItemMark" Binding="{Binding ItemMark}" Width="140"/>
                <DataGridTextColumn Header="账号" Binding="{Binding ItemCode}" Width="90"/>
                <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="70"/>
                <DataGridTextColumn Header="ItemObj (GUID)" Binding="{Binding ItemObj}" Width="*" FontFamily="Consolas"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
